{
  "name": "yunlai-avatar",
  "private": true,
  "description": "Yunlai Robot 3D 角色面部（three.js + three-vrm），打包成一个 iOS 15 能直接跑的 avatar.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=safari15 --legal-comments=eof --outfile=avatar.js"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
