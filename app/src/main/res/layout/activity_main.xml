<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vania · 被控端"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="这台手机装这个 App，开「待命」后等另一台设备发来的指令。所有动作都会记在下面，被远程使用时通知栏会一直显示。"
            android:textSize="13sp"
            android:paddingBottom="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="云盘地址" android:textStyle="bold" />
        <EditText
            android:id="@+id/base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://langhua1998-xiaoju-cloud.hf.space"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="云盘令牌（xa_…）" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="xa_xxx"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="这台设备的名字" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText
            android:id="@+id/device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="比如 测试机B"
            android:inputType="text"
            android:singleLine="true" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="配对口令（两台设备要一样）" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText
            android:id="@+id/pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="自己定一个，别人猜不到的"
            android:inputType="textPassword"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="20dp">
            <Button
                android:id="@+id/perms"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="授权硬件" />
            <Space android:layout_width="12dp" android:layout_height="wrap_content" />
            <Button
                android:id="@+id/toggle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="开始待命" />
        </LinearLayout>

        <Button
            android:id="@+id/bench"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="测模型速度（大约 1 分钟，结果在下面）" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未运行"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="" />
    </LinearLayout>
</ScrollView>
