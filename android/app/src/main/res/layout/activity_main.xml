<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="法莉娅 · 小橘遥控被控端"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="这台手机装这个 App，开「待命」后等另一台设备发来的指令。所有动作都会记在下面，被远程使用时通知栏会一直显示。"
            android:textSize="13sp"
            android:paddingBottom="16dp" />

        <!-- 令牌编译时打进 App；只有本地编、没带令牌的包才显示这一栏 -->
        <LinearLayout
            android:id="@+id/tokenRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="云盘令牌（这个安装包没带令牌）" android:textStyle="bold" />
            <EditText
                android:id="@+id/token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="xa_xxx"
                android:inputType="textPassword"
                android:singleLine="true" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="这台设备的名字" android:textStyle="bold" android:paddingTop="12dp" />
        <RadioGroup
            android:id="@+id/device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/devA" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="A" />
            <RadioButton android:id="@+id/devB" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="B" />
            <RadioButton android:id="@+id/devC" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="C" />
            <RadioButton android:id="@+id/devD" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="D" />
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="配对口令（两台设备要一样，默认 0）" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText
            android:id="@+id/pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="text"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="20dp">
            <Button
                android:id="@+id/perms"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="授权硬件" />
            <Space android:layout_width="12dp" android:layout_height="wrap_content" />
            <Button
                android:id="@+id/toggle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="开始待命" />
        </LinearLayout>

        <Button
            android:id="@+id/update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="检查更新" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未运行"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="" />
    </LinearLayout>
</ScrollView>
